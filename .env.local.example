# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get from: https://neon.tech → New Project → Connection string
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Get from: https://console.upstash.com → New Database → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ─── Admin Access ────────────────────────────────────────────────────────────
# Secret key for /admin route — set to a long random string
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# ─── App URL (used for sitemap + OG tags) ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
